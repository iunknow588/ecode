# Repository settings used by scripts/git/get.* and scripts/git/commit.*
# Copy this file to scripts/git/.env and adjust values if needed.

# Required. All git initialization, pull, commit, and push operations happen here.
REPO_ROOT_OVERRIDE=E:\path\to\your\repo
REPO_SSH_URL=git@github.com:<YOUR_USERNAME>/<YOUR_REPO>.git
REPO_HTTPS_URL=https://github.com/<YOUR_USERNAME>/<YOUR_REPO>.git
PREFERRED_REMOTE_URL=git@github.com:<YOUR_USERNAME>/<YOUR_REPO>.git
